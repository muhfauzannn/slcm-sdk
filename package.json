{
  "name": "slcm-sdk",
  "version": "0.1.0",
  "description": "Type-safe Node.js SDK for integrating with SLCM UI.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "verify-login.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "ci": "pnpm typecheck && pnpm test && pnpm build",
    "verify:login": "pnpm build && node verify-login.mjs",
    "prepublishOnly": "pnpm run ci"
  },
  "keywords": [
    "slcm",
    "universitas-indonesia",
    "sdk",
    "oidc",
    "pkce"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.17.1",
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
